# V1 (mpmac_split) == V2 (mpmac_shared), all modes, all inputs, all state.
#
# Compared through the tie-off wrappers rather than the raw modules. Both
# designs expose a `prod` observation port for the per-mode proofs in mode*.sby;
# comparing that port as well turns this into a 16x16 multiplier equivalence,
# which is the query that does not close. The accumulator is the specification,
# the product is instrumentation, and only the specification needs proving here.

[options]

[gold]
read -sv ../rtl/adders.v ../rtl/mpmac.v ../tb/dut_wrap.v
prep -top dut_split -flatten
rename dut_split mpmac

[gate]
read -sv ../rtl/adders.v ../rtl/mpmac.v ../tb/dut_wrap.v
prep -top dut_shared -flatten
rename dut_shared mpmac

[strategy simple]
use sat
depth 2
